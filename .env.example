# DocuMind AI Configuration
# Security Note: Never expose API keys in frontend, screenshots, or git repos!

# Gemini API Key (Recommended - Get free key at https://aistudio.google.com/)
GEMINI_API_KEY=your_new_key
GEMINI_MODEL=gemini-3.8-flash

# Alternative API Keys
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Embedding Provider: 'local' (all-MiniLM-L6-v2, free & offline) or 'gemini' or 'openai'
EMBEDDING_PROVIDER=local
